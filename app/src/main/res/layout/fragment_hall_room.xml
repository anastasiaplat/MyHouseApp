<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".HallRoomFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <Button
            android:id="@+id/btn_back_from_hallroom"
            android:layout_width="50dp"
            android:layout_height="60dp"
            android:layout_marginStart="28dp"
            android:layout_marginTop="32dp"
            android:background="@android:color/transparent"
            android:text="@string/_1"
            android:visibility="visible"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="UsingOnClickInXml" />

        <View
            android:id="@+id/view_back_from_hallroom"
            android:layout_width="25dp"
            android:layout_height="43dp"
            android:background="@drawable/back"
            app:layout_constraintBottom_toBottomOf="@+id/btn_back_from_hallroom"
            app:layout_constraintEnd_toEndOf="@+id/btn_back_from_hallroom"
            app:layout_constraintStart_toStartOf="@+id/btn_back_from_hallroom"
            app:layout_constraintTop_toTopOf="@+id/btn_back_from_hallroom" />


        <View
            android:id="@+id/view_hall_room_head"
            android:layout_width="100dp"
            android:layout_height="30dp"
            android:background="@drawable/view_hall_room_head"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.315"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.077" />


        <View
            android:id="@+id/view_rectangle_for_temp"
            android:layout_width="325dp"
            android:layout_height="135dp"
            android:background="@drawable/view_rectangle_for_temp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.495"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.2" />


        <View
            android:id="@+id/view_object"
            android:layout_width="327dp"
            android:layout_height="61dp"
            android:layout_gravity="clip_horizontal|center_horizontal"
            android:layout_marginTop="44dp"
            android:background="@drawable/view_rectangle_object"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.511"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/view_rectangle_for_temp" />

        <Switch
            android:id="@+id/switch2"
            android:layout_width="82dp"
            android:layout_height="53dp"
            android:layout_marginStart="265dp"
            android:layout_marginTop="304dp"
            android:layout_marginEnd="58dp"
            android:text=""
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/view_heating"
            android:layout_width="80dp"
            android:layout_height="15dp"
            android:background="@drawable/view_heating"
            app:layout_constraintBottom_toBottomOf="@+id/view_object"
            app:layout_constraintEnd_toStartOf="@+id/switch2"
            app:layout_constraintHorizontal_bias="0.23"
            app:layout_constraintStart_toStartOf="@+id/view_object"
            app:layout_constraintTop_toTopOf="@+id/view_object"
            app:layout_constraintVertical_bias="0.456" />


    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>