            app:layout_constraintEnd_toStartOf="@+id/switch_for_servo"
            app:layout_constraintHorizontal_bias="0.23"
            app:layout_constraintStart_toStartOf="@+id/view_object"
            app:layout_constraintTop_toTopOf="@+id/view_object"
            app:layout_constraintVertical_bias="0.456" />

        <View
            android:id="@+id/view_devices"
            android:layout_width="90dp"
            android:layout_height="27dp"
            android:background="@drawable/view_devices"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.129"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.382" />

