<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <View
        android:id="@+id/Label_MyHouse"
        android:layout_width="238dp"
        android:layout_height="103dp"
        android:background="@drawable/label_myhouse"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.497"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.201" />

    <View
        android:id="@+id/subtitle"
        android:layout_width="236dp"
        android:layout_height="33dp"
        android:layout_marginBottom="126dp"
        android:background="@drawable/subtitle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.502"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/Label_MyHouse"
        app:layout_constraintVertical_bias="0.0" />

    <View
        android:id="@+id/logo"
        android:layout_width="100dp"
        android:layout_height="90dp"
        android:background="@drawable/logo_fg_main"
        app:layout_constraintBottom_toTopOf="@+id/btn_sign_in"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/subtitle"
        app:layout_constraintVertical_bias="0.074" />

    <Button
        android:id="@+id/btn_sign_in"
        android:layout_width="325dp"
        android:layout_height="61dp"
        android:text="@string/_1"
        app:layout_constraintBottom_toBottomOf="@+id/view_entrance"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/view_entrance"
        app:layout_constraintVertical_bias="1.0" />

    <View
        android:id="@+id/view_entrance"
        android:layout_width="327dp"
        android:layout_height="61dp"
        android:layout_alignTop="@+id/btn_sign_in"
        android:layout_alignBottom="@+id/btn_sign_in"
        android:layout_marginTop="156dp"
        android:background="@drawable/btn_entrance"
        app:layout_constraintEnd_toEndOf="@+id/btn_sign_in"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@+id/btn_sign_in"
        app:layout_constraintTop_toBottomOf="@+id/subtitle" />




</androidx.constraintlayout.widget.ConstraintLayout>