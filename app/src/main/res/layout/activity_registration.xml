    <EditText
        android:id="@+id/ET_password0"
        android:layout_width="313dp"
        android:layout_height="48dp"
        android:layout_marginTop="32dp"
        android:ems="10"
        android:hint="@string/password0"
        android:inputType="textPassword"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.51"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ET_login" />

    <EditText
        android:id="@+id/ET_password1"
        android:layout_width="313dp"
        android:layout_height="48dp"
        android:layout_marginTop="32dp"
        android:ems="10"
        android:inputType="textPassword"
        android:hint="@string/password1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.51"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ET_password0" />

    <View
        android:id="@+id/view_to_login1"
        android:layout_width="155dp"
        android:layout_height="23dp"
        android:background="@drawable/view_to_login1"
        app:layout_constraintBottom_toTopOf="@+id/btn_to_register"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ET_password1" />

    <Button
        android:id="@+id/btn_to_login1"
        android:layout_width="220dp"
        android:layout_height="35dp"
        android:background="@android:color/transparent"
        android:text="@string/_1"
        android:visibility="visible"
        app:layout_constraintBottom_toTopOf="@+id/btn_to_register"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ET_password1"
        tools:ignore="UsingOnClickInXml" />

    <Button
        android:id="@+id/btn_to_register"
        android:layout_width="327dp"
        android:layout_height="61dp"
        android:visibility="visible"
        android:text="@string/_1"
        app:layout_constraintBottom_toBottomOf="@+id/view_to_register"
        app:layout_constraintEnd_toEndOf="@+id/view_to_register"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="@+id/view_to_register"
        app:layout_constraintVertical_bias="1.0"
        tools:ignore="UsingOnClickInXml" />

    <View
        android:id="@+id/view_to_register"
        android:layout_width="327dp"
        android:layout_height="61dp"
        android:layout_alignTop="@+id/btn_to_register"
        android:layout_alignBottom="@+id/btn_to_register"
        android:background="@drawable/view_to_register"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.476"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ET_password1"
        app:layout_constraintVertical_bias="0.377" />


