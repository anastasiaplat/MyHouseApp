<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/title_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="MissingConstraints" />

    <Button
        android:id="@+id/btn_back_custom"
        android:layout_width="50dp"
        android:layout_height="60dp"
        android:background="@android:color/transparent"
        android:text="@string/_1"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.088"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.068"
        tools:ignore="UsingOnClickInXml" />

    <View
        android:id="@+id/view_back_custom"
        android:layout_width="25dp"
        android:layout_height="43dp"
        android:background="@drawable/back"
        app:layout_constraintBottom_toBottomOf="@+id/btn_back_custom"
        app:layout_constraintEnd_toEndOf="@+id/btn_back_custom"
        app:layout_constraintStart_toStartOf="@+id/btn_back_custom"
        app:layout_constraintTop_toTopOf="@+id/btn_back_custom" />

</androidx.constraintlayout.widget.ConstraintLayout>