<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".HomeFragment">


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!--главная-->
        <View
            android:id="@+id/view_main"
            android:layout_width="150dp"
            android:layout_height="40dp"
            android:layout_gravity="clip_horizontal|center_horizontal"
            android:layout_marginTop="40dp"
            android:background="@drawable/view_major"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.498"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!--панель АПИ-->
        <View
            android:id="@+id/view_rectangle_for_weather"
            android:layout_width="325dp"
            android:layout_height="125dp"
            android:layout_gravity="clip_horizontal|center_horizontal"
            android:layout_marginTop="16dp"
            android:background="@drawable/view_rectangle_for_temp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/view_main" />

        <!--        температура-->
        <TextView
            android:id="@+id/textview_temp"
            android:layout_width="117dp"
            android:layout_height="55dp"
            android:text="@string/temp"
            android:textColor="#073509"
            android:textSize="40sp"
            app:layout_constraintBottom_toBottomOf="@+id/view_rectangle_for_weather"
            app:layout_constraintEnd_toEndOf="@+id/view_rectangle_for_weather"
            app:layout_constraintHorizontal_bias="0.947"
            app:layout_constraintStart_toStartOf="@+id/view_rectangle_for_weather"
            app:layout_constraintTop_toTopOf="@+id/view_rectangle_for_weather" />

        <!--        дата в формате "ДД месяц, год"-->
        <TextView
            android:id="@+id/textview_date"
            android:layout_width="148dp"
            android:layout_height="27dp"
            android:text="@string/date"
            android:textColor="#073509"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/view_rectangle_for_weather"
            app:layout_constraintEnd_toStartOf="@+id/textview_temp"
            app:layout_constraintHorizontal_bias="0.653"
            app:layout_constraintStart_toStartOf="@+id/view_rectangle_for_weather"
            app:layout_constraintTop_toTopOf="@+id/view_rectangle_for_weather"
            app:layout_constraintVertical_bias="0.265" />

        <!--        местоположение (город)-->
        <TextView
            android:id="@+id/textview_city"
            android:layout_width="148dp"
            android:layout_height="25dp"
            android:text="@string/city"
            android:textColor="#073509"
            android:textSize="20sp"
            app:layout_constraintBottom_toBottomOf="@+id/view_rectangle_for_weather"
            app:layout_constraintEnd_toStartOf="@+id/textview_temp"
            app:layout_constraintHorizontal_bias="0.653"
            app:layout_constraintStart_toStartOf="@+id/view_rectangle_for_weather"
            app:layout_constraintTop_toTopOf="@+id/view_rectangle_for_weather"
            app:layout_constraintVertical_bias="0.65" />

<!--        переключатели-->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/switch_mode"
            android:layout_width="300dp"
            android:layout_height="50dp"
            android:layout_gravity="clip_horizontal|center_horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/view_rectangle_for_weather"
            tools:ignore="MissingConstraints">

            <com.google.android.material.tabs.TabItem
                android:layout_width="368dp"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/navbar"
                android:foregroundTint="@color/navbar"

                android:icon="@drawable/icon_lis_of_blocks"
                tools:layout_editor_absoluteX="34dp"
                tools:layout_editor_absoluteY="301dp" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/navbar"
                android:foregroundTint="@color/navbar"
                android:icon="@drawable/icon_map"
                tools:layout_editor_absoluteX="212dp"
                tools:layout_editor_absoluteY="295dp" />
        </com.google.android.material.tabs.TabLayout>

<!--переключаемая область-->
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/view_mode"
            android:layout_width="300dp"
            android:layout_height="400dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.495"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/switch_mode"
            app:layout_constraintVertical_bias="0.3"
            tools:ignore="MissingConstraints" />




    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>