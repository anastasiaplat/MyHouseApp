<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".rooms.GreenhouseFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <View
            android:id="@+id/view_greenhouse_head"
            android:layout_width="97dp"
            android:layout_height="34dp"
            android:layout_gravity="clip_horizontal|center_horizontal"
            android:layout_marginTop="48dp"
            android:layout_marginEnd="156dp"
            android:background="@drawable/view_greenhouse_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.342"
            app:layout_constraintStart_toEndOf="@+id/btn_back_greenhouse"
            app:layout_constraintTop_toTopOf="parent" />

        <Button
            android:id="@+id/btn_back_greenhouse"
            android:layout_width="50dp"
            android:layout_height="60dp"
            android:layout_marginStart="32dp"
            android:layout_marginTop="32dp"
            android:background="@android:color/transparent"
            android:text="@string/_1"
            android:visibility="visible"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="UsingOnClickInXml" />

        <View
            android:id="@+id/view_back_greenhouse"
            android:layout_width="25dp"
            android:layout_height="43dp"
            android:background="@drawable/back"
            app:layout_constraintBottom_toBottomOf="@+id/btn_back_greenhouse"
            app:layout_constraintEnd_toEndOf="@+id/btn_back_greenhouse"
            app:layout_constraintStart_toStartOf="@+id/btn_back_greenhouse"
            app:layout_constraintTop_toTopOf="@+id/btn_back_greenhouse" />
        <View
            android:id="@+id/view_rectangle_for_temp_greenhouse"
            android:layout_width="325dp"
            android:layout_height="135dp"
            android:background="@drawable/view_rectangle_for_temp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.476"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/view_greenhouse_head"
            app:layout_constraintVertical_bias="0.062" />


        <TextView
            android:id="@+id/tv_temp_greenhouse"
            android:layout_width="217dp"
            android:layout_height="64dp"
            android:textColor="#073509"
            android:textSize="50sp"
            app:layout_constraintBottom_toBottomOf="@+id/view_rectangle_for_temp_greenhouse"
            app:layout_constraintEnd_toEndOf="@+id/view_rectangle_for_temp_greenhouse"
            app:layout_constraintHorizontal_bias="0.62"
            app:layout_constraintStart_toStartOf="@+id/view_rectangle_for_temp_greenhouse"
            app:layout_constraintTop_toTopOf="@+id/view_rectangle_for_temp_greenhouse"
            app:layout_constraintVertical_bias="0.408" />

        <View
            android:id="@+id/view_temp_greenhouse"
            android:layout_width="105dp"
            android:layout_height="17dp"
            android:background="@drawable/view_temp"
            app:layout_constraintBottom_toBottomOf="@+id/view_rectangle_for_temp_greenhouse"
            app:layout_constraintEnd_toEndOf="@+id/view_rectangle_for_temp_greenhouse"
            app:layout_constraintHorizontal_bias="0.236"
            app:layout_constraintStart_toStartOf="@+id/view_rectangle_for_temp_greenhouse"
            app:layout_constraintTop_toBottomOf="@+id/tv_temp_greenhouse"
            app:layout_constraintVertical_bias="0.0" />

        <View
            android:id="@+id/view_humidity_greenhouse"
            android:layout_width="82dp"
            android:layout_height="13dp"
            android:background="@drawable/view_humidity"
            app:layout_constraintBottom_toBottomOf="@+id/view_rectangle_for_temp_greenhouse"
            app:layout_constraintEnd_toEndOf="@+id/view_rectangle_for_temp_greenhouse"
            app:layout_constraintHorizontal_bias="0.302"
            app:layout_constraintStart_toEndOf="@+id/view_temp_greenhouse"
            app:layout_constraintTop_toBottomOf="@+id/tv_temp_greenhouse"
            app:layout_constraintVertical_bias="0.0" />

        <View
            android:id="@+id/view_device_greenhouse"
            android:layout_width="327dp"
            android:layout_height="61dp"
            android:layout_gravity="clip_horizontal|center_horizontal"
            android:layout_marginTop="64dp"
            android:background="@drawable/view_rectangle_object"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.464"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/view_rectangle_for_temp_greenhouse"
            app:layout_constraintVertical_bias="0.008" />

        <Switch
            android:id="@+id/switch_light_greenhouse"
            android:layout_width="82dp"
            android:layout_height="53dp"
            android:text=""
            app:layout_constraintBottom_toBottomOf="@+id/view_device_greenhouse"
            app:layout_constraintEnd_toEndOf="@+id/view_device_greenhouse"
            app:layout_constraintHorizontal_bias="0.869"
            app:layout_constraintStart_toStartOf="@+id/view_device_greenhouse"
            app:layout_constraintTop_toTopOf="@+id/view_device_greenhouse"
            app:layout_constraintVertical_bias="0.5"
            tools:ignore="UseSwitchCompatOrMaterialXml" />

        <View
            android:id="@+id/view_light_greenhouse"
            android:layout_width="40dp"
            android:layout_height="15dp"
            android:layout_marginStart="8dp"
            android:textColor="#073509"
            android:background="@drawable/view_light"
            app:layout_constraintBottom_toBottomOf="@+id/view_device_greenhouse"
            app:layout_constraintEnd_toStartOf="@+id/switch_light_greenhouse"
            app:layout_constraintHorizontal_bias="0.212"
            app:layout_constraintStart_toStartOf="@+id/view_device_greenhouse"
            app:layout_constraintTop_toTopOf="@+id/view_device_greenhouse" />

        <View
            android:id="@+id/view_devices_greenhouse"
            android:layout_width="90dp"
            android:layout_height="27dp"
            android:background="@drawable/view_devices"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.127"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/view_rectangle_for_temp_greenhouse"
            app:layout_constraintVertical_bias="0.044" />
        <View
            android:id="@+id/view_device1_greenhouse"
            android:layout_width="327dp"
            android:layout_height="61dp"
            android:layout_gravity="clip_horizontal|center_horizontal"
            android:background="@drawable/view_rectangle_object"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.464"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/view_device_greenhouse"
            app:layout_constraintVertical_bias="0.06" />

        <Switch
            android:id="@+id/switch_watering_greenhouse"
            android:layout_width="82dp"
            android:layout_height="53dp"
            android:text=""
            app:layout_constraintBottom_toBottomOf="@+id/view_device1_greenhouse"
            app:layout_constraintEnd_toEndOf="@+id/view_device1_greenhouse"
            app:layout_constraintHorizontal_bias="0.869"
            app:layout_constraintStart_toStartOf="@+id/view_device1_greenhouse"
            app:layout_constraintTop_toTopOf="@+id/view_device1_greenhouse"
            app:layout_constraintVertical_bias="1.0"
            tools:ignore="UseSwitchCompatOrMaterialXml" />

        <View
            android:id="@+id/view_heating_greenhouse"
            android:layout_width="55dp"
            android:layout_height="15dp"
            android:layout_marginStart="8dp"
            android:textColor="#073509"
            android:background="@drawable/view_watering"
            app:layout_constraintBottom_toBottomOf="@+id/view_device1_greenhouse"
            app:layout_constraintEnd_toStartOf="@+id/switch_watering_greenhouse"
            app:layout_constraintHorizontal_bias="0.241"
            app:layout_constraintStart_toStartOf="@+id/view_device1_greenhouse"
            app:layout_constraintTop_toTopOf="@+id/view_device1_greenhouse"
            app:layout_constraintVertical_bias="0.488" />

        <View
            android:id="@+id/view_device2_greenhouse"
            android:layout_width="327dp"
            android:layout_height="61dp"
            android:layout_gravity="clip_horizontal|center_horizontal"
            android:background="@drawable/view_rectangle_object"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.488"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/view_device1_greenhouse"
            app:layout_constraintVertical_bias="0.065" />

        <Switch
            android:id="@+id/switch_winding_greenhouse"
            android:layout_width="82dp"
            android:layout_height="53dp"
            android:text=""
            app:layout_constraintBottom_toBottomOf="@+id/view_device2_greenhouse"
            app:layout_constraintEnd_toEndOf="@+id/view_device2_greenhouse"
            app:layout_constraintHorizontal_bias="0.869"
            app:layout_constraintStart_toStartOf="@+id/view_device2_greenhouse"
            app:layout_constraintTop_toTopOf="@+id/view_device2_greenhouse"
            app:layout_constraintVertical_bias="1.0"
            tools:ignore="UseSwitchCompatOrMaterialXml" />

        <View
            android:id="@+id/view_winding_greenhouse"
            android:layout_width="128dp"
            android:layout_height="19dp"
            android:textColor="#073509"
            android:background="@drawable/view_winding"
            app:layout_constraintBottom_toBottomOf="@+id/view_device2_greenhouse"
            app:layout_constraintEnd_toStartOf="@+id/switch_winding_greenhouse"
            app:layout_constraintHorizontal_bias="0.477"
            app:layout_constraintStart_toStartOf="@+id/view_device2_greenhouse"
            app:layout_constraintTop_toTopOf="@+id/view_device2_greenhouse"
            app:layout_constraintVertical_bias="0.512" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>